# Copy to .env (git-ignored) and fill in locally. Never commit a real key.
# The key is read only by the server; it is never sent to the browser.
# Without it the app starts, but every AI call returns a clear "key not set" error.
SARVAM_API_KEY=

# Optional overrides (defaults verified against docs.sarvam.ai on 2026-11-21)
# SARVAM_ACTOR_MODEL=sarvam-105b-conversations
# SARVAM_COACH_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh

# Voice (speech-to-text and spoken replies) is on whenever the key is set. Set to false to turn it off.
# SPEECH_ENABLED=true

# PORT=5173
