# Copy to .env (git-ignored) and fill in locally. Never commit a real key.
# The key is read only by the server; it is never sent to the browser.

# mock (default): scripted fixtures, labelled Demo. sarvam: live chat.
# If CHAT_PROVIDER=sarvam and SARVAM_API_KEY is empty, live calls fail.
# The app does not fill that gap with demo replies.
CHAT_PROVIDER=mock
SARVAM_API_KEY=

# Optional overrides (defaults verified against docs.sarvam.ai on 2026-11-21)
# SARVAM_ACTOR_MODEL=sarvam-105b-conversations
# SARVAM_COACH_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh

# Speech is offered only when SARVAM_API_KEY is set. Set to false to disable it anyway.
# SPEECH_ENABLED=true

# Artificial delay for mock replies so loading states are visible.
# MOCK_DELAY_MS=600
# PORT=5173
